---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGINE } from '../../i18n';

const lang = 'es' as const;
---

<BaseLayout
  title="Contacto | Filippo Cassi · Closer & Account Manager"
  description="Si buscas un closer o un account manager que trate a cada cliente como una relación y no como una transacción, escríbeme."
  lang={lang}
  translations={PAGINE.contatti}
>
  <section class="fc-hero compact">
    <div class="fc-over">Contacto</div>
    <h1 class="fc-h1">Hablemos.</h1>
    <p>
      Si buscas un closer o un account manager que trate a cada cliente como una
      relación y no como una transacción, escríbeme.
    </p>
  </section>

  <section class="fc-sec" style="padding-top:70px">
    <div class="fc-cgrid">
      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📧</div>
        <h3>Email</h3>
        <p><a href="mailto:filippocassi@gmail.com">filippocassi@gmail.com</a></p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📱</div>
        <h3>Teléfono</h3>
        <p><a href="tel:+34610325936">+34 610 325 936</a></p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">💼</div>
        <h3>LinkedIn</h3>
        <p>
          <a
            href="https://www.linkedin.com/in/fcassi"
            target="_blank"
            rel="noopener">linkedin.com/in/fcassi</a
          >
        </p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📍</div>
        <h3>Dónde estoy</h3>
        <p class="plain">Las Palmas de Gran Canaria</p>
      </div>
    </div>
  </section>
</BaseLayout>
