---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contatti | Filippo Cassi · Closer & Account Manager"
  description="Se cerchi un closer o un account manager che tratta ogni cliente come una relazione e non come una transazione, scrivimi."
>
  <section class="fc-hero compact">
    <div class="fc-over">Contatti</div>
    <h1 class="fc-h1">Parliamone.</h1>
    <p>
      Se cerchi un closer o un account manager che tratta ogni cliente come una
      relazione e non come una transazione, scrivimi.
    </p>
  </section>

  <section class="fc-sec" style="padding-top:70px">
    <div class="fc-cgrid">
      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📧</div>
        <h3>Email</h3>
        <p><a href="mailto:filippocassi@gmail.com">filippocassi@gmail.com</a></p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📱</div>
        <h3>Telefono</h3>
        <p><a href="tel:+34610325936">+34 610 325 936</a></p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">💼</div>
        <h3>LinkedIn</h3>
        <p>
          <a
            href="https://www.linkedin.com/in/fcassi"
            target="_blank"
            rel="noopener">linkedin.com/in/fcassi</a
          >
        </p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📍</div>
        <h3>Dove sono</h3>
        <p class="plain">Las Palmas de Gran Canaria</p>
      </div>
    </div>
  </section>
</BaseLayout>
