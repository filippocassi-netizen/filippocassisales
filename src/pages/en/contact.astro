---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PAGINE } from '../../i18n';

const lang = 'en' as const;
---

<BaseLayout
  title="Contact | Filippo Cassi · Closer & Account Manager"
  description="If you are looking for a closer or an account manager who treats every client as a relationship and not a transaction, get in touch."
  lang={lang}
  translations={PAGINE.contatti}
>
  <section class="fc-hero compact">
    <div class="fc-over">Contact</div>
    <h1 class="fc-h1">Let's talk.</h1>
    <p>
      If you are looking for a closer or an account manager who treats every
      client as a relationship and not a transaction, get in touch.
    </p>
  </section>

  <section class="fc-sec" style="padding-top:70px">
    <div class="fc-cgrid">
      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📧</div>
        <h3>Email</h3>
        <p><a href="mailto:filippocassi@gmail.com">filippocassi@gmail.com</a></p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📱</div>
        <h3>Phone</h3>
        <p><a href="tel:+34610325936">+34 610 325 936</a></p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">💼</div>
        <h3>LinkedIn</h3>
        <p>
          <a
            href="https://www.linkedin.com/in/fcassi"
            target="_blank"
            rel="noopener">linkedin.com/in/fcassi</a
          >
        </p>
      </div>

      <div class="fc-cbox">
        <div class="ic" aria-hidden="true">📍</div>
        <h3>Where I am</h3>
        <p class="plain">Las Palmas de Gran Canaria</p>
      </div>
    </div>
  </section>
</BaseLayout>
