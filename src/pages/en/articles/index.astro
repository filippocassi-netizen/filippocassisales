---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListaArticoli from '../../../components/ListaArticoli.astro';
import { INDICE_BLOG, TESTI } from '../../../i18n';

const lang = 'en' as const;
const t = TESTI[lang];
---

<BaseLayout
  title={`${t.titoloBlog} | Filippo Cassi`}
  description={t.sottotitoloBlog}
  lang={lang}
  translations={INDICE_BLOG}
>
  <section class="fc-sec">
    <div class="fc-kick">{t.titoloBlog}</div>
    <h1>{t.titoloBlog}</h1>
    <p class="fc-lede">{t.sottotitoloBlog}</p>
    <ListaArticoli lang={lang} />
  </section>
</BaseLayout>
