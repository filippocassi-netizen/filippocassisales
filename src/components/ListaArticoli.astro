---
import { TESTI, formattaData, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = TESTI[lang];

interface ModuloArticolo {
  url?: string;
  frontmatter: {
    lang: Lang;
    title: string;
    description: string;
    date: string;
  };
}

const moduli = import.meta.glob<ModuloArticolo>('../pages/**/*.md', { eager: true });

const articoli = Object.values(moduli)
  .filter((m) => m.frontmatter?.lang === lang)
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
  );
---

<ul class="fc-lista-articoli">
  {
    articoli.map((a) => (
      <li>
        <article>
          <p class="fc-meta">
            <time datetime={a.frontmatter.date}>
              {formattaData(a.frontmatter.date, lang)}
            </time>
          </p>
          <h2>
            <a href={a.url}>{a.frontmatter.title}</a>
          </h2>
          <p>{a.frontmatter.description}</p>
          <p class="fc-leggi">
            <a href={a.url}>{t.leggi} →</a>
          </p>
        </article>
      </li>
    ))
  }
</ul>
