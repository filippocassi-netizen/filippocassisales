---
import BaseLayout from './BaseLayout.astro';
import { INDICE_BLOG, TESTI, formattaData, type Lang } from '../i18n';

interface Frontmatter {
  lang: Lang;
  title: string;
  seoTitle?: string;
  description: string;
  date: string;
  author?: string;
  /** Immagine di apertura, es. /img/blog/<file>.jpg. Opzionale: se manca non viene renderizzata. */
  image?: string;
  imageAlt?: string;
  translations?: Partial<Record<Lang, string>>;
}

const { frontmatter } = Astro.props as { frontmatter: Frontmatter };
const lang = frontmatter.lang ?? 'it';
const t = TESTI[lang];
---

<BaseLayout
  title={frontmatter.seoTitle || frontmatter.title}
  description={frontmatter.description}
  ogImage={frontmatter.image}
  lang={lang}
  translations={frontmatter.translations}
>
  <article class="fc-article">
    <p class="fc-back">
      <a href={INDICE_BLOG[lang]}>{t.tornaAlBlog}</a>
    </p>

    <h1>{frontmatter.title}</h1>

    <p class="fc-meta">
      <time datetime={frontmatter.date}>{formattaData(frontmatter.date, lang)}</time>
      {frontmatter.author && <span> · {frontmatter.author}</span>}
    </p>

    {
      frontmatter.image && (
        <img
          class="fc-article-img"
          src={frontmatter.image}
          alt={frontmatter.imageAlt ?? ''}
          loading="lazy"
        />
      )
    }

    <div class="fc-article-body">
      <slot />
    </div>

    <p class="fc-back fc-back-bottom">
      <a href={INDICE_BLOG[lang]}>{t.tornaAlBlog}</a>
    </p>
  </article>
</BaseLayout>
